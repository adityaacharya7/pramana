# Environment configuration for PRAMANA & UPAKARAKA AI
# For local development: copy this to .env and configure your keys
# For Vercel production: add these environment variables in your Vercel Project Settings

# Google Gemini API Key for UPAKARAKA Cyber Crime Forensic Intelligence
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PRAMANA Build & Database (optional for local SQLite, required for Vercel Postgres)
# PRAMANA_BUILD=demo
# PRAMANA_DB_URL=postgresql+psycopg://user:password@host/dbname
# PRAMANA_JWT_SECRET=your_32_character_minimum_random_secret_string
